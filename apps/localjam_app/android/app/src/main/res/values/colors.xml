<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Adaptive-icon background (flutter_launcher_icons writes this one). -->
    <color name="ic_launcher_background">#D9366B</color>
    <!-- `launch_background` is the splash ground; `app_background` is what the
         OS paints behind the Flutter surface once it is up. Both match the
         app's own `background` (white here, black in values-night) so the
         cold start shows no seam between the splash and the first frame. -->
    <color name="launch_background">#FFFFFF</color>
    <color name="app_background">#FFFFFF</color>
</resources>