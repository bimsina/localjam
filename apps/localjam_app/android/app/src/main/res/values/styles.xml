<?xml version="1.0" encoding="utf-8"?>
<!-- Regenerated by `dart run flutter_native_splash:create`. The colorBackground /
     windowBackground overrides on NormalTheme are ours — re-apply them if the
     generator ever stomps this file (see README.md, "Brand assets"). -->
<resources>
    <!-- Painted by the OS while the process starts. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:colorBackground">@color/launch_background</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <!-- Painted from the moment the engine attaches, and behind the Flutter
         surface for the rest of the process's life. Pinned to the brand canvas
         so there is no white frame between the splash and the first UI frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorBackground">@color/app_background</item>
    </style>
</resources>
